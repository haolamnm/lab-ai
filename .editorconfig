root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

[*.md]
# Markdown uses trailing double-space for a hard line break.
trim_trailing_whitespace = false

[*.{json,jsonc}]
indent_size = 2

[*.svg]
insert_final_newline = true

# `ruff format` writes four spaces and will reformat anything else, so the
# editor has to agree with it or every save fights `make format`.
[*.py]
indent_size = 4

# Make requires a literal tab before each recipe line. Spaces here are not a
# style choice, they are a "missing separator" error.
[Makefile]
indent_style = tab
